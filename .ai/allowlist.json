{
  "version": 2,
  "description": "Creator-managed permissions for quest orchestration. Edit this file to pre-approve or restrict quest agent actions. Changes take effect on next quest run.",
  "quest_completion": {
    "enabled": true,
    "on_complete": "celebrate",
    "animation_style": "epic",
    "show_end_credits": true,
    "show_progress_bars": true,
    "ascii_art": true,
    "animation_speed": "default",
    "safe_mode": "auto"
  },
  "auto_approve_phases": {
    "plan_creation": true,
    "plan_review": true,
    "plan_refinement": true,
    "implementation": false,
    "code_review": true,
    "fix_loop": true
  },
  "claude_role_transport": "auto",
  "models": {
    "planner": "gpt-5.6-sol",
    "plan-reviewer-a": "claude-opus-5",
    "plan-reviewer-b": "gpt-5.6-terra",
    "arbiter": "claude-opus-5",
    "builder": "gpt-5.6-sol",
    "code-reviewer-a": "claude-opus-5",
    "code-reviewer-b": "gpt-5.6-terra",
    "review-arbiter": "claude-opus-5",
    "fixer": "gpt-5.6-terra"
  },
  "quest_startup": {
    "branch_mode": "branch",
    "branch_prefix": "quest/",
    "worktree_root": ".worktrees/quest"
  },
  "quest_id_format": "slug-first",
  "review_mode": "full",
  "fast_review_thresholds": {
    "max_files": 5,
    "max_loc": 300
  },
  "role_permissions": {
    "planner_agent": {
      "file_write": [
        ".quest/**",
        "docs/**",
        "ideas/**",
        ".ai/**",
        "*.md"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "find",
        "rg",
        "grep",
        "wc",
        "ls",
        "tree",
        "git status",
        "git diff",
        "gh pr view"
      ]
    },
    "plan_review_a": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "pytest",
        "git status",
        "git diff",
        "git log",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "uv run pytest",
        "gh pr view",
        "python3 -m pytest"
      ]
    },
    "plan_review_b": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "pytest",
        "git status",
        "git diff",
        "git log",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "uv run pytest",
        "gh pr view",
        "python3 -m pytest"
      ]
    },
    "arbiter_agent": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "git status",
        "git diff",
        "gh pr view"
      ]
    },
    "review_arbiter_agent": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "git status",
        "git diff",
        "gh pr view"
      ]
    },
    "builder_agent": {
      "file_write": [
        ".quest/**",
        ".ai/**",
        ".github/**",
        "docs/**",
        "ideas/**",
        "scripts/**",
        "src/components/PreviewPanel.test.tsx",
        "src/components/__tests__/PreviewPanel.ime.test.tsx",
        "src/components/preview/EditMode.tsx",
        "src/components/preview/PreviewMode.tsx",
        "src/components/preview/PreviewOverflowMenu.test.tsx",
        "src/components/preview/PreviewOverflowMenu.tsx",
        "src/components/preview/PreviewPanel.tsx",
        "src/components/preview/PreviewToolbar.compact.test.tsx",
        "src/components/preview/PreviewToolbar.tsx",
        "src/components/preview/previewCopy.ts",
        "src/components/sourceLineRehype.ts",
        "src/render/markdownToHtml.parity.test.tsx",
        "src/styles/global.css",
        "tests/**",
        ".skills/**",
        "*.md",
        "*.json",
        "*.txt",
        "*.sh",
        "*.py"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "git status",
        "git diff",
        "git diff --check",
        "git diff --name-only",
        "git diff --exit-code",
        "git merge-base HEAD origin/main",
        "git rev-parse HEAD",
        "npm run lint",
        "npm run typecheck",
        "npm test -- --run",
        "npm run build",
        "npm run test:e2e",
        "npm run build:mac",
        "python3 scripts/security_ci_guard.py",
        "bash scripts/build-mac-app.sh --configuration Debug",
        "bash scripts/build-mac-app.sh --configuration Release --allow-development-license-key-for-pr",
        "bash scripts/verify-document-library-smoke-build.sh",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/AppSchemeImportRouteTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/DocumentLibraryStoreTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/ShellBridgeDocumentLibraryTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/DocumentLibraryWindowTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/ExternalOpenRouterTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=licensed .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=grace .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=expired-reminder .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=unlicensed .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=invalid .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=license-check-failed .build/mac/Build/Products/Debug/doc2md.app",
        "git status --porcelain -- src packages index.html vite.config.ts",
        "git diff --exit-code origin/main...HEAD -- src packages index.html vite.config.ts ':(exclude)src/desktop/__tests__/macBuildAllowlist.test.ts'"
      ]
    },
    "code_review_agent": {
      "file_write": [
        ".quest/**"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "pytest",
        "git diff",
        "git log",
        "git status",
        "rg",
        "grep",
        "find",
        "ls",
        "wc",
        "uv run pytest",
        "gh pr view",
        "python3 -m pytest"
      ]
    },
    "fixer_agent": {
      "file_write": [
        ".quest/**",
        ".ai/**",
        ".github/**",
        "docs/**",
        "ideas/**",
        "scripts/**",
        "src/components/PreviewPanel.test.tsx",
        "src/components/__tests__/PreviewPanel.ime.test.tsx",
        "src/components/preview/EditMode.tsx",
        "src/components/preview/PreviewMode.tsx",
        "src/components/preview/PreviewOverflowMenu.test.tsx",
        "src/components/preview/PreviewOverflowMenu.tsx",
        "src/components/preview/PreviewPanel.tsx",
        "src/components/preview/PreviewToolbar.compact.test.tsx",
        "src/components/preview/PreviewToolbar.tsx",
        "src/components/preview/previewCopy.ts",
        "src/components/sourceLineRehype.ts",
        "src/render/markdownToHtml.parity.test.tsx",
        "src/styles/global.css",
        "tests/**",
        ".skills/**",
        "*.md",
        "*.json",
        "*.txt",
        "*.sh",
        "*.py"
      ],
      "file_read": [
        "**"
      ],
      "bash": [
        "git status",
        "git diff",
        "git diff --check",
        "git diff --name-only",
        "git diff --exit-code",
        "git merge-base HEAD origin/main",
        "git rev-parse HEAD",
        "npm run lint",
        "npm run typecheck",
        "npm test -- --run",
        "npm run build",
        "npm run test:e2e",
        "npm run build:mac",
        "python3 scripts/security_ci_guard.py",
        "bash scripts/build-mac-app.sh --configuration Debug",
        "bash scripts/build-mac-app.sh --configuration Release --allow-development-license-key-for-pr",
        "bash scripts/verify-document-library-smoke-build.sh",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/AppSchemeImportRouteTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/DocumentLibraryStoreTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/ShellBridgeDocumentLibraryTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/DocumentLibraryWindowTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests -only-testing:doc2mdTests/ExternalOpenRouterTests",
        "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild test -project apps/macos/doc2md.xcodeproj -scheme doc2md -configuration Debug -destination 'platform=macOS' -derivedDataPath .build/mac-tests",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=licensed .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=grace .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=expired-reminder .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=unlicensed .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=invalid .build/mac/Build/Products/Debug/doc2md.app",
        "open -n --env DOC2MD_TEST_LICENSE_STATE=license-check-failed .build/mac/Build/Products/Debug/doc2md.app",
        "git status --porcelain -- src packages index.html vite.config.ts",
        "git diff --exit-code origin/main...HEAD -- src packages index.html vite.config.ts ':(exclude)src/desktop/__tests__/macBuildAllowlist.test.ts'"
      ]
    }
  },
  "solo": {
    "max_fix_iterations": 2
  },
  "gates": {
    "require_approval_before_commit": true,
    "require_approval_before_push": true,
    "require_approval_before_delete": true,
    "max_plan_iterations": 4,
    "max_fix_iterations": 3
  }
}
